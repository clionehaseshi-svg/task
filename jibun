/* ========================= LONG-TERM MODULE ========================= */
const TASKS_KEY = 'long-term-tasks';
let tasks = [];
function toISO(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }
function fromISO(s){ const [y,m,d]=s.split('-').map(Number); return new Date(y,m-1,d); }
function addDays(d,n){ const r=new Date(d); r.setDate(r.getDate()+n); return r; }
function dayDiff(a,b){ return Math.round((b-a)/86400000); }
function todayNorm(){ const n=new Date(); return new Date(n.getFullYear(), n.getMonth(), n.getDate()); }
function fmtDate(d){ return `${d.getMonth()+1}/${d.getDate()}`; }

async function l_loadTasks(){
  try{ const res = await window.storage.get(TASKS_KEY); tasks = res && res.value ? JSON.parse(res.value) : []; }
  catch(e){ tasks = []; }
}
async function l_saveTasks(){ try{ await window.storage.set(TASKS_KEY, JSON.stringify(tasks)); flashSaved(); } catch(e){ console.error(e); } }

function l_computePace(t){
  const today = todayNorm(), start = fromISO(t.start), deadline = fromISO(t.deadline);
  const total = t.subtasks.length, done = t.subtasks.filter(s=>s.done).length, remaining = total-done;
  const elapsedDays = Math.max(dayDiff(start, today), 1);
  const daysToDeadline = dayDiff(today, deadline);
  let status='neutral', message='', projectedDate=null;
  if(total===0){ message = 'サブタスクを追加すると予測を計算します'; }
  else if(remaining===0){ status='good'; message='全サブタスク完了です！'; }
  else {
    const rate = done/elapsedDays;
    if(rate<=0){ status='bad'; message = `このペースだと完了の見込みが立ちません（残り${remaining}個）`; }
    else {
      const daysNeeded = Math.ceil(remaining/rate);
      projectedDate = addDays(today, daysNeeded);
      if(daysNeeded <= daysToDeadline){ status='good'; message = `このペースならあと約${daysNeeded}日で完了見込み（締切${daysToDeadline}日前に余裕あり）`; }
      else { status='bad'; const overBy = daysNeeded - daysToDeadline; message = `このペースだと完了まで約${daysNeeded}日かかり、締切に約${overBy}日遅れる見込みです`; }
    }
  }
  return { done, total, remaining, daysToDeadline, status, message, projectedDate };
}
function l_render(){
  const today = todayNorm();
  const eventDate = addDays(today,50), examDate = addDays(today,170);
  document.getElementById('l_quickRow').innerHTML = `
    <button class="quick-chip" id="l_quickEvent">＋ イベント本番（${fmtDate(eventDate)} / 50日後）</button>
    <button class="quick-chip" id="l_quickExam">＋ 資格試験（${fmtDate(examDate)} / 170日後）</button>`;
  document.getElementById('l_quickEvent').onclick = () => l_openTaskSheet(null, {title:'イベント本番', start:toISO(today), deadline:toISO(eventDate), category:'work'});
  document.getElementById('l_quickExam').onclick = () => l_openTaskSheet(null, {title:'資格試験', start:toISO(today), deadline:toISO(examDate), category:'study'});

  document.getElementById('l_statCount').textContent = tasks.length;
  let good=0, bad=0;
  tasks.forEach(t => { const p=l_computePace(t); if(p.status==='good') good++; if(p.status==='bad') bad++; });
  document.getElementById('l_statGood').textContent = good;
  document.getElementById('l_statBad').textContent = bad;

  const card = document.getElementById('l_ganttCard');
  if(tasks.length===0){ card.innerHTML = '<p class="empty-note">タスクを追加するとここに表示されます。</p>'; }
  else {
    let minDate = today, maxDate = addDays(today,30);
    tasks.forEach(t => { const s=fromISO(t.start), d=fromISO(t.deadline); if(s<minDate) minDate=s; if(d>maxDate) maxDate=d; });
    minDate = addDays(minDate,-2); maxDate = addDays(maxDate,2);
    const totalSpan = Math.max(dayDiff(minDate,maxDate),1);
    let html = `<div class="gantt-scale">`;
    for(let i=0;i<=4;i++){ const d=addDays(minDate, Math.round(totalSpan*i/4)); html += `<span style="left:${(i/4)*100}%">${fmtDate(d)}</span>`; }
    html += `</div>`;
    const todayPct = (dayDiff(minDate,today)/totalSpan)*100;
    tasks.forEach(t => {
      const cat = catByKey[t.category] || CATEGORIES[4];
      const s=fromISO(t.start), d=fromISO(t.deadline);
      const leftPct = (dayDiff(minDate,s)/totalSpan)*100;
      const widthPct = Math.max((dayDiff(s,d)/totalSpan)*100, 2);
      const p = l_computePace(t);
      const fillPct = p.total>0 ? (p.done/p.total)*100 : 0;
      html += `<div class="gantt-row">
        <div class="gantt-label" title="${escapeHtml(t.title)}">${escapeHtml(t.title)}</div>
        <div class="gantt-track">
          <div class="gantt-bar" style="left:${leftPct}%; width:${widthPct}%; background:${cat.soft};">
            <div class="gantt-fill" style="width:${fillPct}%; background:${cat.color};"></div>
          </div>
          ${todayPct>=0 && todayPct<=100 ? `<div class="gantt-today-line" style="left:${todayPct}%"></div>` : ''}
        </div></div>`;
    });
    html += `<div class="gantt-legend"><span><span class="legend-swatch" style="background:var(--bad)"></span>今日</span><span><span class="legend-swatch" style="background:var(--cat-work)"></span>バーの塗り＝サブタスク完了率</span></div>`;
    card.innerHTML = html;
  }

  const list = document.getElementById('l_taskList');
  if(tasks.length===0){ list.innerHTML = '<p class="empty-note">まだ長期タスクがありません。</p>'; return; }
  list.innerHTML = '';
  tasks.forEach(t => {
    const cat = catByKey[t.category] || CATEGORIES[4];
    const p = l_computePace(t);
    const fillPct = p.total>0 ? Math.round((p.done/p.total)*100) : 0;
    const cardEl = document.createElement('div'); cardEl.className='task-card';
    cardEl.innerHTML = `
      <div class="task-head">
        <div><div class="task-title">${escapeHtml(t.title)}</div>
        <div class="task-meta">${t.start.replace(/-/g,'/')} 〜 ${t.deadline.replace(/-/g,'/')} ・ 残り${p.daysToDeadline}日 ・ ${cat.label}</div></div>
        <button class="task-menu-btn" data-delete="${t.id}">✕</button>
      </div>
      <div class="pace-badge ${p.status}">${p.message}</div>
      <div class="progress-wrap">
        <div class="progress-bar-outer"><div class="progress-bar-inner" style="width:${fillPct}%; background:${cat.color};"></div></div>
        <div class="progress-text">${p.done}/${p.total}</div>
      </div>
      <div class="subtask-list" data-subtasklist="${t.id}"></div>
      <div class="add-subtask-row">
        <input type="text" placeholder="サブタスクを追加" data-subinput="${t.id}">
        <button data-subadd="${t.id}">追加</button>
      </div>`;
    list.appendChild(cardEl);
    const subListEl = cardEl.querySelector(`[data-subtasklist="${t.id}"]`);
    t.subtasks.forEach(st => {
      const row = document.createElement('div'); row.className='subtask-row';
      row.innerHTML = `
        <div class="subtask-check" style="${st.done?`background:${cat.color};border-color:${cat.color};`:''}" data-toggle="${st.id}">${st.done?'✓':''}</div>
        <div class="subtask-label ${st.done?'done':''}">${escapeHtml(st.label)}</div>
        <button class="subtask-del" data-subdel="${st.id}">削除</button>`;
      subListEl.appendChild(row);
      row.querySelector('[data-toggle]').onclick = () => { st.done=!st.done; st.doneAt = st.done ? toISO(todayNorm()) : null; l_render(); l_saveTasks(); };
      row.querySelector('[data-subdel]').onclick = () => { t.subtasks = t.subtasks.filter(x=>x.id!==st.id); l_render(); l_saveTasks(); };
    });
    cardEl.querySelector(`[data-subadd="${t.id}"]`).onclick = () => {
      const input = cardEl.querySelector(`[data-subinput="${t.id}"]`);
      const label = input.value.trim(); if(!label) return;
      t.subtasks.push({ id:'st'+Date.now()+Math.random().toString(36).slice(2,6), label, done:false, doneAt:null });
      input.value=''; l_render(); l_saveTasks();
    };
    cardEl.querySelector(`[data-subinput="${t.id}"]`).addEventListener('keydown', e => { if(e.key==='Enter') cardEl.querySelector(`[data-subadd="${t.id}"]`).click(); });
    cardEl.querySelector('[data-delete]').onclick = () => {
      if(confirm(`「${t.title}」を削除しますか？サブタスクも全て削除されます。`)){ tasks = tasks.filter(x=>x.id!==t.id); l_render(); l_saveTasks(); }
    };
  });
}
function l_openTaskSheet(existing, prefill){
  const isEdit = !!existing;
  const base = existing || prefill || {title:'', start:toISO(todayNorm()), deadline:toISO(addDays(todayNorm(),30)), category:'work'};
  const overlay = document.createElement('div'); overlay.className='overlay';
  overlay.innerHTML = `
    <div class="sheet">
      <h2>${isEdit ? 'タスクを編集' : '長期タスクを追加'}</h2>
      <p class="sheet-sub">締め切りのある大きなタスクを登録します。あとでサブタスクを追加できます。</p>
      <div class="field"><label>タスク名</label><input type="text" id="fTitle" value="${escapeHtml(base.title)}" placeholder="例）〇〇イベント本番"></div>
      <div class="row-2">
        <div class="field"><label>開始日</label><input type="date" id="fStart" value="${base.start}"></div>
        <div class="field"><label>締切日</label><input type="date" id="fDeadline" value="${base.deadline}"></div>
      </div>
      <div class="field"><label>カテゴリー</label><div class="cat-picker" id="catPicker"></div></div>
      <div class="sheet-actions">
        <button class="btn ghost" id="cancelBtn">キャンセル</button>
        <button class="btn primary" id="saveBtn">保存</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  let selectedCat = base.category;
  const picker = overlay.querySelector('#catPicker');
  function renderPicker(){
    picker.innerHTML='';
    CATEGORIES.forEach(c=>{
      const opt=document.createElement('div');
      opt.className='cat-opt'+(c.key===selectedCat?' selected':'');
      opt.style.background=c.soft; opt.style.color=c.color; opt.textContent=c.label;
      opt.onclick=()=>{ selectedCat=c.key; renderPicker(); };
      picker.appendChild(opt);
    });
  }
  renderPicker();
  overlay.addEventListener('click', e=>{ if(e.target===overlay) overlay.remove(); });
  overlay.querySelector('#cancelBtn').onclick=()=>overlay.remove();
  overlay.querySelector('#saveBtn').onclick = () => {
    const title = overlay.querySelector('#fTitle').value.trim();
    const start = overlay.querySelector('#fStart').value;
    const deadline = overlay.querySelector('#fDeadline').value;
    if(!title){ alert('タスク名を入力してください'); return; }
    if(!start||!deadline||start>=deadline){ alert('開始日は締切日より前にしてください'); return; }
    if(isEdit){ existing.title=title; existing.start=start; existing.deadline=deadline; existing.category=selectedCat; }
    else{ tasks.push({ id:'t'+Date.now()+Math.random().toString(36).slice(2,6), title, start, deadline, category:selectedCat, subtasks:[] }); }
    overlay.remove(); l_render(); l_saveTasks();
  };
}
document.getElementById('l_addTaskBtn').onclick = () => l_openTaskSheet(null, null);

